---
import '../styles/global.css';

const {
  title = '猫モチーフのジュエリーブランド | Petit Chaton(プチシャトン)',
  description = '猫モチーフのジュエリーブランド「Petit Chaton（プチシャトン）」。三日月に寄り添う子猫や蝶をかたどり、天然石をあしらった繊細なネックレスをお届けします。',
} = Astro.props;

const site = 'https://petit-chaton.com';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const ogImage = `${site}/og-image.jpg`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'Petit Chaton',
      alternateName: 'プチシャトン',
      url: `${site}/`,
      logo: ogImage,
      sameAs: [
        'https://www.instagram.com/petitchaton_pc/',
        'https://www.amazon.co.jp/stores/PetitChaton%EF%BC%88%E3%83%97%E3%83%81%E3%82%B7%E3%83%A3%E3%83%88%E3%83%B3%EF%BC%89/page/42B28375-5641-4A6C-8635-CDDB565AC645',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Petit Chaton',
      url: `${site}/`,
      inLanguage: 'ja',
      publisher: { '@id': `${site}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" type="image/gif" href={`${base}favicon.gif`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Petit Chaton" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1400" />
    <meta property="og:image:height" content="700" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="google-site-verification" content="RlweWgjXozOa4kOp6kr8IyCkJhqYhlTudV_m7RwX2tQ" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital@0;1&display=swap" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
